{
  "name": "leagueswitcher",
  "version": "0.1.0",
  "private": true,
  "description": "Switch between League of Legends accounts in one click, with a live dashboard of rank, level and region.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx scripts/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scan-secrets": "node scripts/scan-secrets.mjs",
    "probe:status": "node scripts/probes/client-status.mjs",
    "probe:swagger": "node scripts/probes/swagger-dump.mjs",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-baseline.ps1",
    "build:main": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "fonts": "node scripts/fetch-fonts.mjs",
    "crests": "node scripts/fetch-crests.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "main": "dist/main/index.mjs"
}
